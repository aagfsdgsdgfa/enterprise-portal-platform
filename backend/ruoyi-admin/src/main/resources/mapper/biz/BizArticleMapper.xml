<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.biz.mapper.BizArticleMapper">

    <resultMap type="BizArticle" id="BizArticleResult">
        <result property="articleId"    column="article_id"    />
        <result property="categoryType"    column="category_type"    />
        <result property="title"    column="title"    />
        <result property="summary"    column="summary"    />
        <result property="coverImg"    column="cover_img"    />
        <result property="content"    column="content"    />
        <result property="author"    column="author"    />
        <result property="isTop"    column="is_top"    />
        <result property="viewCount"    column="view_count"    />
        <result property="seoTitle"    column="seo_title"    />
        <result property="seoKeywords"    column="seo_keywords"    />
        <result property="seoDescription"    column="seo_description"    />
        <result property="status"    column="status"    />
        <result property="publishTime"    column="publish_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectBizArticleVo">
        select article_id, category_type, title, summary, cover_img, content, author, is_top, view_count, seo_title, seo_keywords, seo_description, status, publish_time, create_by, create_time, update_by, update_time, remark from biz_article
    </sql>

    <select id="selectBizArticleList" parameterType="BizArticle" resultMap="BizArticleResult">
        <include refid="selectBizArticleVo"/>
        <where>
            <if test="categoryType != null  and categoryType != ''"> and category_type = #{categoryType}</if>
            <if test="title != null  and title != ''"> and title like concat('%', #{title}, '%')</if>
            <if test="summary != null  and summary != ''"> and summary = #{summary}</if>
            <if test="coverImg != null  and coverImg != ''"> and cover_img = #{coverImg}</if>
            <if test="content != null  and content != ''"> and content = #{content}</if>
            <if test="author != null  and author != ''"> and author = #{author}</if>
            <if test="isTop != null  and isTop != ''"> and is_top = #{isTop}</if>
            <if test="viewCount != null "> and view_count = #{viewCount}</if>
            <if test="seoTitle != null  and seoTitle != ''"> and seo_title = #{seoTitle}</if>
            <if test="seoKeywords != null  and seoKeywords != ''"> and seo_keywords = #{seoKeywords}</if>
            <if test="seoDescription != null  and seoDescription != ''"> and seo_description = #{seoDescription}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="publishTime != null "> and publish_time = #{publishTime}</if>
        </where>
        ORDER BY is_top DESC, publish_time DESC, create_time DESC
    </select>

    <select id="selectBizArticleByArticleId" parameterType="Long" resultMap="BizArticleResult">
        <include refid="selectBizArticleVo"/>
        where article_id = #{articleId}
    </select>

    <insert id="insertBizArticle" parameterType="BizArticle" useGeneratedKeys="true" keyProperty="articleId">
        insert into biz_article
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="categoryType != null">category_type,</if>
            <if test="title != null and title != ''">title,</if>
            <if test="summary != null">summary,</if>
            <if test="coverImg != null">cover_img,</if>
            <if test="content != null">content,</if>
            <if test="author != null">author,</if>
            <if test="isTop != null">is_top,</if>
            <if test="viewCount != null">view_count,</if>
            <if test="seoTitle != null">seo_title,</if>
            <if test="seoKeywords != null">seo_keywords,</if>
            <if test="seoDescription != null">seo_description,</if>
            <if test="status != null">status,</if>
            <if test="publishTime != null">publish_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="categoryType != null">#{categoryType},</if>
            <if test="title != null and title != ''">#{title},</if>
            <if test="summary != null">#{summary},</if>
            <if test="coverImg != null">#{coverImg},</if>
            <if test="content != null">#{content},</if>
            <if test="author != null">#{author},</if>
            <if test="isTop != null">#{isTop},</if>
            <if test="viewCount != null">#{viewCount},</if>
            <if test="seoTitle != null">#{seoTitle},</if>
            <if test="seoKeywords != null">#{seoKeywords},</if>
            <if test="seoDescription != null">#{seoDescription},</if>
            <if test="status != null">#{status},</if>
            <if test="publishTime != null">#{publishTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateBizArticle" parameterType="BizArticle">
        update biz_article
        <trim prefix="SET" suffixOverrides=",">
            <if test="categoryType != null">category_type = #{categoryType},</if>
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="summary != null">summary = #{summary},</if>
            <if test="coverImg != null">cover_img = #{coverImg},</if>
            <if test="content != null">content = #{content},</if>
            <if test="author != null">author = #{author},</if>
            <if test="isTop != null">is_top = #{isTop},</if>
            <if test="viewCount != null">view_count = #{viewCount},</if>
            <if test="seoTitle != null">seo_title = #{seoTitle},</if>
            <if test="seoKeywords != null">seo_keywords = #{seoKeywords},</if>
            <if test="seoDescription != null">seo_description = #{seoDescription},</if>
            <if test="status != null">status = #{status},</if>
            <if test="publishTime != null">publish_time = #{publishTime},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where article_id = #{articleId}
    </update>

    <delete id="deleteBizArticleByArticleId" parameterType="Long">
        delete from biz_article where article_id = #{articleId}
    </delete>

    <delete id="deleteBizArticleByArticleIds" parameterType="String">
        delete from biz_article where article_id in
        <foreach item="articleId" collection="array" open="(" separator="," close=")">
            #{articleId}
        </foreach>
    </delete>
</mapper>