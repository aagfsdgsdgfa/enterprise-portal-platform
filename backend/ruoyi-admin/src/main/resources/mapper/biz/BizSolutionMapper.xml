<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.biz.mapper.BizSolutionMapper">
    
    <resultMap type="BizSolution" id="BizSolutionResult">
        <result property="solutionId"    column="solution_id"    />
        <result property="title"    column="title"    />
        <result property="subTitle"    column="sub_title"    />
        <result property="summary"    column="summary"    />
        <result property="icon"    column="icon"    />
        <result property="bannerImg"    column="banner_img"    />
        <result property="content"    column="content"    />
        <result property="painPoints"    column="pain_points"    />
        <result property="valueProps"    column="value_props"    />
        <result property="relatedProductIds"    column="related_product_ids"    />
        <result property="status"    column="status"    />
        <result property="sortOrder"    column="sort_order"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectBizSolutionVo">
        select solution_id, title, sub_title, summary, icon, banner_img, content, pain_points, value_props, related_product_ids, status, sort_order, create_by, create_time, update_by, update_time, remark from biz_solution
    </sql>

    <select id="selectBizSolutionList" parameterType="BizSolution" resultMap="BizSolutionResult">
        <include refid="selectBizSolutionVo"/>
        <where>  
            <if test="title != null  and title != ''"> and title = #{title}</if>
            <if test="subTitle != null  and subTitle != ''"> and sub_title = #{subTitle}</if>
            <if test="summary != null  and summary != ''"> and summary = #{summary}</if>
            <if test="icon != null  and icon != ''"> and icon = #{icon}</if>
            <if test="bannerImg != null  and bannerImg != ''"> and banner_img = #{bannerImg}</if>
            <if test="content != null  and content != ''"> and content = #{content}</if>
            <if test="painPoints != null  and painPoints != ''"> and pain_points = #{painPoints}</if>
            <if test="valueProps != null  and valueProps != ''"> and value_props = #{valueProps}</if>
            <if test="relatedProductIds != null  and relatedProductIds != ''"> and related_product_ids = #{relatedProductIds}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="sortOrder != null "> and sort_order = #{sortOrder}</if>
        </where>
    </select>
    
    <select id="selectBizSolutionBySolutionId" parameterType="Long" resultMap="BizSolutionResult">
        <include refid="selectBizSolutionVo"/>
        where solution_id = #{solutionId}
    </select>

    <insert id="insertBizSolution" parameterType="BizSolution" useGeneratedKeys="true" keyProperty="solutionId">
        insert into biz_solution
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="title != null and title != ''">title,</if>
            <if test="subTitle != null">sub_title,</if>
            <if test="summary != null">summary,</if>
            <if test="icon != null">icon,</if>
            <if test="bannerImg != null">banner_img,</if>
            <if test="content != null">content,</if>
            <if test="painPoints != null">pain_points,</if>
            <if test="valueProps != null">value_props,</if>
            <if test="relatedProductIds != null">related_product_ids,</if>
            <if test="status != null">status,</if>
            <if test="sortOrder != null">sort_order,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="title != null and title != ''">#{title},</if>
            <if test="subTitle != null">#{subTitle},</if>
            <if test="summary != null">#{summary},</if>
            <if test="icon != null">#{icon},</if>
            <if test="bannerImg != null">#{bannerImg},</if>
            <if test="content != null">#{content},</if>
            <if test="painPoints != null">#{painPoints},</if>
            <if test="valueProps != null">#{valueProps},</if>
            <if test="relatedProductIds != null">#{relatedProductIds},</if>
            <if test="status != null">#{status},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateBizSolution" parameterType="BizSolution">
        update biz_solution
        <trim prefix="SET" suffixOverrides=",">
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="subTitle != null">sub_title = #{subTitle},</if>
            <if test="summary != null">summary = #{summary},</if>
            <if test="icon != null">icon = #{icon},</if>
            <if test="bannerImg != null">banner_img = #{bannerImg},</if>
            <if test="content != null">content = #{content},</if>
            <if test="painPoints != null">pain_points = #{painPoints},</if>
            <if test="valueProps != null">value_props = #{valueProps},</if>
            <if test="relatedProductIds != null">related_product_ids = #{relatedProductIds},</if>
            <if test="status != null">status = #{status},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where solution_id = #{solutionId}
    </update>

    <delete id="deleteBizSolutionBySolutionId" parameterType="Long">
        delete from biz_solution where solution_id = #{solutionId}
    </delete>

    <delete id="deleteBizSolutionBySolutionIds" parameterType="String">
        delete from biz_solution where solution_id in 
        <foreach item="solutionId" collection="array" open="(" separator="," close=")">
            #{solutionId}
        </foreach>
    </delete>
</mapper>