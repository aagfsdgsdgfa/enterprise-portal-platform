<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.biz.mapper.BizProjectMapper">
    
    <resultMap type="BizProject" id="BizProjectResult">
        <result property="projectId"    column="project_id"    />
        <result property="projectName"    column="project_name"    />
        <result property="clientName"    column="client_name"    />
        <result property="industryType"    column="industry_type"    />
        <result property="coverImg"    column="cover_img"    />
        <result property="detailBanner"    column="detail_banner"    />
        <result property="background"    column="background"    />
        <result property="solutionDesc"    column="solution_desc"    />
        <result property="achievement"    column="achievement"    />
        <result property="keyDataVal"    column="key_data_val"    />
        <result property="keyDataDesc"    column="key_data_desc"    />
        <result property="completionDate"    column="completion_date"    />
        <result property="relatedProductIds"    column="related_product_ids"    />
        <result property="sortOrder"    column="sort_order"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectBizProjectVo">
        select project_id, project_name, client_name, industry_type, cover_img, detail_banner, background, solution_desc, achievement, key_data_val, key_data_desc, completion_date, related_product_ids, sort_order, create_by, create_time, update_by, update_time from biz_project
    </sql>

    <select id="selectBizProjectList" parameterType="BizProject" resultMap="BizProjectResult">
        <include refid="selectBizProjectVo"/>
        <where>  
            <if test="projectName != null  and projectName != ''"> and project_name like concat('%', #{projectName}, '%')</if>
            <if test="clientName != null  and clientName != ''"> and client_name like concat('%', #{clientName}, '%')</if>
            <if test="industryType != null  and industryType != ''"> and industry_type = #{industryType}</if>
            <if test="coverImg != null  and coverImg != ''"> and cover_img = #{coverImg}</if>
            <if test="detailBanner != null  and detailBanner != ''"> and detail_banner = #{detailBanner}</if>
            <if test="background != null  and background != ''"> and background = #{background}</if>
            <if test="solutionDesc != null  and solutionDesc != ''"> and solution_desc = #{solutionDesc}</if>
            <if test="achievement != null  and achievement != ''"> and achievement = #{achievement}</if>
            <if test="keyDataVal != null  and keyDataVal != ''"> and key_data_val = #{keyDataVal}</if>
            <if test="keyDataDesc != null  and keyDataDesc != ''"> and key_data_desc = #{keyDataDesc}</if>
            <if test="completionDate != null "> and completion_date = #{completionDate}</if>
            <if test="relatedProductIds != null  and relatedProductIds != ''"> and related_product_ids = #{relatedProductIds}</if>
            <if test="sortOrder != null "> and sort_order = #{sortOrder}</if>
        </where>
    </select>
    
    <select id="selectBizProjectByProjectId" parameterType="Long" resultMap="BizProjectResult">
        <include refid="selectBizProjectVo"/>
        where project_id = #{projectId}
    </select>

    <insert id="insertBizProject" parameterType="BizProject" useGeneratedKeys="true" keyProperty="projectId">
        insert into biz_project
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="projectName != null and projectName != ''">project_name,</if>
            <if test="clientName != null">client_name,</if>
            <if test="industryType != null">industry_type,</if>
            <if test="coverImg != null">cover_img,</if>
            <if test="detailBanner != null">detail_banner,</if>
            <if test="background != null">background,</if>
            <if test="solutionDesc != null">solution_desc,</if>
            <if test="achievement != null">achievement,</if>
            <if test="keyDataVal != null">key_data_val,</if>
            <if test="keyDataDesc != null">key_data_desc,</if>
            <if test="completionDate != null">completion_date,</if>
            <if test="relatedProductIds != null">related_product_ids,</if>
            <if test="sortOrder != null">sort_order,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="projectName != null and projectName != ''">#{projectName},</if>
            <if test="clientName != null">#{clientName},</if>
            <if test="industryType != null">#{industryType},</if>
            <if test="coverImg != null">#{coverImg},</if>
            <if test="detailBanner != null">#{detailBanner},</if>
            <if test="background != null">#{background},</if>
            <if test="solutionDesc != null">#{solutionDesc},</if>
            <if test="achievement != null">#{achievement},</if>
            <if test="keyDataVal != null">#{keyDataVal},</if>
            <if test="keyDataDesc != null">#{keyDataDesc},</if>
            <if test="completionDate != null">#{completionDate},</if>
            <if test="relatedProductIds != null">#{relatedProductIds},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateBizProject" parameterType="BizProject">
        update biz_project
        <trim prefix="SET" suffixOverrides=",">
            <if test="projectName != null and projectName != ''">project_name = #{projectName},</if>
            <if test="clientName != null">client_name = #{clientName},</if>
            <if test="industryType != null">industry_type = #{industryType},</if>
            <if test="coverImg != null">cover_img = #{coverImg},</if>
            <if test="detailBanner != null">detail_banner = #{detailBanner},</if>
            <if test="background != null">background = #{background},</if>
            <if test="solutionDesc != null">solution_desc = #{solutionDesc},</if>
            <if test="achievement != null">achievement = #{achievement},</if>
            <if test="keyDataVal != null">key_data_val = #{keyDataVal},</if>
            <if test="keyDataDesc != null">key_data_desc = #{keyDataDesc},</if>
            <if test="completionDate != null">completion_date = #{completionDate},</if>
            <if test="relatedProductIds != null">related_product_ids = #{relatedProductIds},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where project_id = #{projectId}
    </update>

    <delete id="deleteBizProjectByProjectId" parameterType="Long">
        delete from biz_project where project_id = #{projectId}
    </delete>

    <delete id="deleteBizProjectByProjectIds" parameterType="String">
        delete from biz_project where project_id in 
        <foreach item="projectId" collection="array" open="(" separator="," close=")">
            #{projectId}
        </foreach>
    </delete>
</mapper>