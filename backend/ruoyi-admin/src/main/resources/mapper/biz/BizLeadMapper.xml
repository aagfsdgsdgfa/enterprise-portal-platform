<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.biz.mapper.BizLeadMapper">
    
    <resultMap type="BizLead" id="BizLeadResult">
        <result property="leadId"    column="lead_id"    />
        <result property="type"    column="type"    />
        <result property="contactName"    column="contact_name"    />
        <result property="phone"    column="phone"    />
        <result property="companyName"    column="company_name"    />
        <result property="email"    column="email"    />
        <result property="intentProduct"    column="intent_product"    />
        <result property="message"    column="message"    />
        <result property="budgetRange"    column="budget_range"    />
        <result property="ipAddress"    column="ip_address"    />
        <result property="sourceUrl"    column="source_url"    />
        <result property="status"    column="status"    />
        <result property="handleResult"    column="handle_result"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectBizLeadVo">
        select lead_id, type, contact_name, phone, company_name, email, intent_product, message, budget_range, ip_address, source_url, status, handle_result, create_time, update_by, update_time from biz_lead
    </sql>

    <select id="selectBizLeadList" parameterType="BizLead" resultMap="BizLeadResult">
        <include refid="selectBizLeadVo"/>
        <where>  
            <if test="type != null  and type != ''"> and type = #{type}</if>
            <if test="contactName != null  and contactName != ''"> and contact_name like concat('%', #{contactName}, '%')</if>
            <if test="phone != null  and phone != ''"> and phone = #{phone}</if>
            <if test="companyName != null  and companyName != ''"> and company_name like concat('%', #{companyName}, '%')</if>
            <if test="email != null  and email != ''"> and email = #{email}</if>
            <if test="intentProduct != null  and intentProduct != ''"> and intent_product = #{intentProduct}</if>
            <if test="message != null  and message != ''"> and message = #{message}</if>
            <if test="budgetRange != null  and budgetRange != ''"> and budget_range = #{budgetRange}</if>
            <if test="ipAddress != null  and ipAddress != ''"> and ip_address = #{ipAddress}</if>
            <if test="sourceUrl != null  and sourceUrl != ''"> and source_url = #{sourceUrl}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="handleResult != null  and handleResult != ''"> and handle_result = #{handleResult}</if>
        </where>
    </select>
    
    <select id="selectBizLeadByLeadId" parameterType="Long" resultMap="BizLeadResult">
        <include refid="selectBizLeadVo"/>
        where lead_id = #{leadId}
    </select>

    <insert id="insertBizLead" parameterType="BizLead" useGeneratedKeys="true" keyProperty="leadId">
        insert into biz_lead
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="type != null">type,</if>
            <if test="contactName != null and contactName != ''">contact_name,</if>
            <if test="phone != null and phone != ''">phone,</if>
            <if test="companyName != null">company_name,</if>
            <if test="email != null">email,</if>
            <if test="intentProduct != null">intent_product,</if>
            <if test="message != null">message,</if>
            <if test="budgetRange != null">budget_range,</if>
            <if test="ipAddress != null">ip_address,</if>
            <if test="sourceUrl != null">source_url,</if>
            <if test="status != null">status,</if>
            <if test="handleResult != null">handle_result,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="type != null">#{type},</if>
            <if test="contactName != null and contactName != ''">#{contactName},</if>
            <if test="phone != null and phone != ''">#{phone},</if>
            <if test="companyName != null">#{companyName},</if>
            <if test="email != null">#{email},</if>
            <if test="intentProduct != null">#{intentProduct},</if>
            <if test="message != null">#{message},</if>
            <if test="budgetRange != null">#{budgetRange},</if>
            <if test="ipAddress != null">#{ipAddress},</if>
            <if test="sourceUrl != null">#{sourceUrl},</if>
            <if test="status != null">#{status},</if>
            <if test="handleResult != null">#{handleResult},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateBizLead" parameterType="BizLead">
        update biz_lead
        <trim prefix="SET" suffixOverrides=",">
            <if test="type != null">type = #{type},</if>
            <if test="contactName != null and contactName != ''">contact_name = #{contactName},</if>
            <if test="phone != null and phone != ''">phone = #{phone},</if>
            <if test="companyName != null">company_name = #{companyName},</if>
            <if test="email != null">email = #{email},</if>
            <if test="intentProduct != null">intent_product = #{intentProduct},</if>
            <if test="message != null">message = #{message},</if>
            <if test="budgetRange != null">budget_range = #{budgetRange},</if>
            <if test="ipAddress != null">ip_address = #{ipAddress},</if>
            <if test="sourceUrl != null">source_url = #{sourceUrl},</if>
            <if test="status != null">status = #{status},</if>
            <if test="handleResult != null">handle_result = #{handleResult},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where lead_id = #{leadId}
    </update>

    <delete id="deleteBizLeadByLeadId" parameterType="Long">
        delete from biz_lead where lead_id = #{leadId}
    </delete>

    <delete id="deleteBizLeadByLeadIds" parameterType="String">
        delete from biz_lead where lead_id in 
        <foreach item="leadId" collection="array" open="(" separator="," close=")">
            #{leadId}
        </foreach>
    </delete>
</mapper>