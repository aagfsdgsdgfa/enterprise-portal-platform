<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.biz.mapper.BizResourceMapper">
    
    <resultMap type="BizResource" id="BizResourceResult">
        <result property="resourceId"    column="resource_id"    />
        <result property="title"    column="title"    />
        <result property="filePath"    column="file_path"    />
        <result property="fileSize"    column="file_size"    />
        <result property="fileType"    column="file_type"    />
        <result property="needLogin"    column="need_login"    />
        <result property="downloadCount"    column="download_count"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectBizResourceVo">
        select resource_id, title, file_path, file_size, file_type, need_login, download_count, status, create_by, create_time, update_by, update_time, remark from biz_resource
    </sql>

    <select id="selectBizResourceList" parameterType="BizResource" resultMap="BizResourceResult">
        <include refid="selectBizResourceVo"/>
        <where>  
            <if test="title != null  and title != ''"> and title = #{title}</if>
            <if test="filePath != null  and filePath != ''"> and file_path = #{filePath}</if>
            <if test="fileSize != null  and fileSize != ''"> and file_size = #{fileSize}</if>
            <if test="fileType != null  and fileType != ''"> and file_type = #{fileType}</if>
            <if test="needLogin != null  and needLogin != ''"> and need_login = #{needLogin}</if>
            <if test="downloadCount != null "> and download_count = #{downloadCount}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectBizResourceByResourceId" parameterType="Long" resultMap="BizResourceResult">
        <include refid="selectBizResourceVo"/>
        where resource_id = #{resourceId}
    </select>

    <insert id="insertBizResource" parameterType="BizResource" useGeneratedKeys="true" keyProperty="resourceId">
        insert into biz_resource
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="title != null and title != ''">title,</if>
            <if test="filePath != null and filePath != ''">file_path,</if>
            <if test="fileSize != null">file_size,</if>
            <if test="fileType != null">file_type,</if>
            <if test="needLogin != null">need_login,</if>
            <if test="downloadCount != null">download_count,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="title != null and title != ''">#{title},</if>
            <if test="filePath != null and filePath != ''">#{filePath},</if>
            <if test="fileSize != null">#{fileSize},</if>
            <if test="fileType != null">#{fileType},</if>
            <if test="needLogin != null">#{needLogin},</if>
            <if test="downloadCount != null">#{downloadCount},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateBizResource" parameterType="BizResource">
        update biz_resource
        <trim prefix="SET" suffixOverrides=",">
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="filePath != null and filePath != ''">file_path = #{filePath},</if>
            <if test="fileSize != null">file_size = #{fileSize},</if>
            <if test="fileType != null">file_type = #{fileType},</if>
            <if test="needLogin != null">need_login = #{needLogin},</if>
            <if test="downloadCount != null">download_count = #{downloadCount},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where resource_id = #{resourceId}
    </update>

    <delete id="deleteBizResourceByResourceId" parameterType="Long">
        delete from biz_resource where resource_id = #{resourceId}
    </delete>

    <delete id="deleteBizResourceByResourceIds" parameterType="String">
        delete from biz_resource where resource_id in 
        <foreach item="resourceId" collection="array" open="(" separator="," close=")">
            #{resourceId}
        </foreach>
    </delete>
</mapper>